.claude

# The after-dark terminal branch. content/after-dark.source.twee is the
# authored source (edit this, or edit in Twine and export over it); the rest
# are build products regenerated from it — see the yarn scripts below. All of
# it is gitignored as spoiler content; the committed, git-safe copies are the
# *.ts files under lib/terminal/, encoded via yarn encode-after-dark and
# yarn encode-after-dark-source.
/content/after-dark.source.twee
/content/after-dark.json

# Local-model polish batches (yarn after-dark-polish) — extracted prose sent
# to Ollama and its raw responses. Working files, not the authored source.
/content/after-dark.polish/
/content/after-dark.polish-prompt.txt

# Diagnostic graph view, generated by yarn graph-after-dark. Not the authoring
# source — see the note above content/after-dark.source.twee.
/content/after-dark.graph.twee
/content/after-dark.graph.twine.html
/content/after-dark.spine.json
